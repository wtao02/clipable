# Copy to .env and fill in every value.
# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
MINIO_ROOT_USER=vitryne
MINIO_ROOT_PASSWORD=
DB_IDHASHKEY=
COOKIE_KEY=

# Optional. Leave unset for a host-only session cookie, which works on any
# hostname or IP. Set it only when serving the same instance from several
# subdomains, for example example.com.
# COOKIE_DOMAIN=

# Set to false after your accounts exist.
ALLOW_REGISTRATION=true

# Largest accepted upload, for example 500MB, 5GB or 20GB.
MAX_UPLOAD_SIZE=5GB

# Host port the app is published on. Keep it on localhost behind a TLS proxy.
HTTP_BIND=127.0.0.1:8080

# Optional: use a published image instead of building, for example
# ghcr.io/wtao02/vitryne:latest or ghcr.io/wtao02/vitryne:v0.1.0
# VITRYNE_IMAGE=ghcr.io/wtao02/vitryne:latest
