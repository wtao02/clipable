# Copy to .env and fill in every value. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
MINIO_ROOT_USER=vitryne
MINIO_ROOT_PASSWORD=
DB_IDHASHKEY=
COOKIE_KEY=

# Public hostname the site is served from (used for the session cookie domain)
COOKIE_DOMAIN=clips.example.com

# Set to false after your accounts exist
ALLOW_REGISTRATION=true
MAX_UPLOAD_SIZE=5GB

# Host port the app is published on (bind to localhost behind a reverse proxy)
HTTP_BIND=127.0.0.1:8080
