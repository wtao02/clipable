  "narrative": {
    "northStar": "The Quiet Screening Room",
    "overview": "Vitryne is a dark room where the clip is the only bright thing. The shell stays near-black and deliberately unremarkable; thumbnails, posters and video frames carry the color. Chrome is built from warm paper-white type, hairline rules and flat surfaces, never from ornament. The visitor should feel the product recede the moment playback starts.\n\nThe voice is calm, exact and unadorned. Every label names what it does, every number is set in mono where it reads as data, and every primary action is a single cream shape on the dark ground. There are no gradients, glass panels, shadows or decorative accents. Separation comes from a 1px hairline and one step of surface value.\n\nThe world is sized for a small self-hosted instance, not a content network: a compact 1200px page, a three-column clip wall, a 1024px watch page, and narrow 380–640px forms. Future editing surfaces inherit the same quiet shell; they should add capability, not a second visual language.",
    "keyCharacteristics": [
      "Warm near-black ground with a paper-white primary.",
      "Flat surfaces and 1px hairlines; no shadows at rest.",
      "Archivo for voice, IBM Plex Mono for data and state.",
      "Clips own the color; the interface stays neutral.",
      "8px surfaces, 6px controls, 5px wordmark mark."
    ],
    "rules": [
      {
        "name": "The One Light Rule",
        "body": "The clip image is the only saturated field in the product. Do not add a hue accent to navigation, panels, or headings to compensate.",
        "section": "colors"
      },
      {
        "name": "The Cue Rule",
        "body": "Red, green and amber appear only when they carry meaning. They are never decorative, never a second brand color.",
        "section": "colors"
      },
      {
        "name": "The Data Voice Rule",
        "body": "Mono is for counts, dates, status and measurements. It is never used for prose, headings or navigation.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. If a shadow ever appears, it must describe a state or a physical layer, not decorate a card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep exactly one Projector White primary action per view.",
      "Do use a 1px Hairline for separation and an 8px radius for surfaces.",
      "Do set counts, dates, percentages and status in IBM Plex Mono.",
      "Do let the clip image carry all of the color; keep chrome neutral.",
      "Do use sentence case for headings, buttons and labels.",
      "Do keep folder navigation in a 220px sticky rail at xl, collapsing to one wrapping chip row below xl, with counts in mono.",
      "Do treat the shared clip page as the only public surface; libraries, profiles, folders and feeds stay owner-only.",
      "Do extend this shell to future editing surfaces rather than inventing an editor skin."
    ],
    "donts": [
      "Don't add hue accents, gradients, glass, blur or decorative shadows.",
      "Don't use pill-shaped cards, nested cards or cards inside cards.",
      "Don't use a display serif or a system display face for headings.",
      "Don't use mono for prose or navigation.",
      "Don't use kickers, eyebrows or section numbers above headings.",
      "Don't rely on color alone for destructive, success or warning meaning."
    ]
  }
}
