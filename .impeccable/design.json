      "css": ".ds-folder-rail{width:220px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:13px}.ds-folder-rail p{margin:0 0 8px;padding:0 12px;color:var(--muted-2);font-size:12px}.ds-folder-row{display:flex;width:100%;height:32px;align-items:center;justify-content:space-between;gap:12px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--muted);font:inherit;text-align:left;cursor:pointer;transition:background .12s ease-out,color .12s ease-out}.ds-folder-row:hover{background:var(--surface-2);color:var(--fg)}.ds-folder-row.is-active{background:var(--surface-2);color:var(--fg)}.ds-folder-row span{color:var(--muted-2);font-family:\"IBM Plex Mono\",ui-monospace,monospace;font-size:11px}.ds-folder-new{margin-top:8px;justify-content:flex-start}"
    }
