    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single cream action on a view: Sign in, Upload, Save, or the empty-state CTA.",
      "html": "<button class=\"ds-btn-primary\">Upload clip</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border:0;border-radius:6px;background:var(--fg);color:var(--bg);font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:500;line-height:1;white-space:nowrap;cursor:pointer;transition:background .12s ease-out}.ds-btn-primary:hover{background:#fff}.ds-btn-primary:focus-visible{outline:2px solid rgba(244,242,236,.6);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "In-flow actions such as Upload, Copy link, Choose file, Cancel, and retry.",
      "html": "<button class=\"ds-btn-secondary\">Copy link</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--fg);font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:500;line-height:1;white-space:nowrap;cursor:pointer;transition:background .12s ease-out,border-color .12s ease-out}.ds-btn-secondary:hover{background:var(--surface-2);border-color:var(--border-strong)}.ds-btn-secondary:focus-visible{outline:2px solid rgba(244,242,236,.6);outline-offset:2px}"
    },
