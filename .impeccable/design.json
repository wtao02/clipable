      "html": "<button class=\"ds-btn-ghost\" aria-label=\"Edit clip\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--muted);font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:500;line-height:1;cursor:pointer;transition:background .12s ease-out,color .12s ease-out}.ds-btn-ghost:hover{background:var(--surface-2);color:var(--fg)}.ds-btn-ghost:focus-visible{outline:2px solid rgba(244,242,236,.6);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Raised Booth field with a Hairline Strong border; labels sit above at 13px.",
      "html": "<label class=\"ds-field\"><span>Username</span><input class=\"ds-input\" placeholder=\"Username\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:500;color:var(--fg)}.ds-input{height:40px;width:100%;padding:0 12px;border:1px solid var(--border-strong);border-radius:6px;background:var(--surface-2);color:var(--fg);font-family:inherit;font-size:14px;font-weight:400;outline:none;transition:border-color .12s ease-out}.ds-input::placeholder{color:var(--muted-2)}.ds-input:hover{border-color:var(--muted-2)}.ds-input:focus{border-color:rgba(244,242,236,.4);outline:2px solid rgba(244,242,236,.6);outline-offset:2px}"
    },
    {
      "name": "Header / Navigation",
      "kind": "nav",
      "description": "64px sticky bar: play-mark wordmark, Browse, 320px search, Upload, account; two rows below 640px.",
      "html": "<header class=\"ds-header\"><a class=\"ds-wordmark\" href=\"#\"><span class=\"ds-mark\"><svg viewBox=\"0 0 12 12\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M3 1.5 10 6 3 10.5Z\" fill=\"currentColor\"/></svg></span>Vitryne</a><nav class=\"ds-nav\"><a href=\"#\">Browse</a></nav><div class=\"ds-search\">Search clips</div><div class=\"ds-account\"><button class=\"ds-btn-primary ds-small\">Sign in</button></div></header>",
      "css": ".ds-header{display:flex;align-items:center;gap:24px;height:64px;padding:0 24px;border-bottom:1px solid var(--border);background:var(--bg);font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-wordmark{display:flex;align-items:center;gap:8px;color:var(--fg);font-size:15px;font-weight:600;letter-spacing:-.02em;text-decoration:none}.ds-mark{display:grid;place-items:center;width:24px;height:24px;border:1px solid var(--border-strong);border-radius:5px;color:var(--fg)}.ds-nav{display:flex;gap:20px;font-size:13px}.ds-nav a{color:var(--muted);text-decoration:none}.ds-nav a:hover{color:var(--fg)}.ds-search{flex:1;max-width:320px;margin-left:auto;height:36px;display:flex;align-items:center;padding:0 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--muted-2);font-size:13px}.ds-account{display:flex;gap:8px}.ds-small{height:32px;font-size:13px;padding:0 12px}"
