      "css": ".ds-card{display:block;color:var(--fg);text-decoration:none;font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-card-media{position:relative;display:grid;place-items:center;aspect-ratio:16/9;border:1px solid var(--border);border-radius:8px;background:#000}.ds-play{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(0,0,0,.7);color:var(--fg);opacity:0;transition:opacity .2s ease-out}.ds-card:hover .ds-play{opacity:1}.ds-card-title{display:block;margin-top:12px;font-size:15px;font-weight:500;line-height:1.6}.ds-card-meta{display:block;margin-top:4px;color:var(--muted);font-family:\"IBM Plex Mono\",ui-monospace,monospace;font-size:12px;line-height:1.5}"
    },
    {
      "name": "Modal",
      "kind": "custom",
      "refersTo": "modal",
      "description": "Portaled 448px panel on a 70% backdrop; app shell inert, focus trapped, Escape restores the trigger.",
      "html": "<div class=\"ds-backdrop\"><div class=\"ds-modal\" role=\"dialog\" aria-modal=\"true\"><h2>Edit clip</h2><p>Title and description fields live here.</p><div class=\"ds-actions\"><button class=\"ds-btn-secondary\">Cancel</button><button class=\"ds-btn-primary\">Save changes</button></div></div></div>",
      "css": ".ds-backdrop{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.7)}.ds-modal{width:100%;max-width:448px;padding:20px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--fg);font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-modal h2{margin:0;font-size:16px;font-weight:500}.ds-modal p{margin:16px 0 0;color:var(--muted);font-size:13px;line-height:1.5}.ds-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.ds-btn-primary,.ds-btn-secondary{font-family:inherit;cursor:pointer}.ds-btn-primary{height:32px;padding:0 12px;border:0;border-radius:6px;background:var(--fg);color:var(--bg);font-size:13px;font-weight:500}.ds-btn-secondary{height:32px;padding:0 12px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--fg);font-size:13px;font-weight:500}"
